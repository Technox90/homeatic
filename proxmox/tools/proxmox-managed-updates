#!/usr/bin/env python3
"""Opt-in updates of existing Proxmox-managed files. No guest creation or reset."""
import datetime
import json
import os
import pathlib
import re
import shutil
import stat
import subprocess
import tempfile
import urllib.request

CONF = pathlib.Path("/root/.config/proxmox-auto-updater/proxmox-updates.json")
STATE = pathlib.Path("/var/lib/proxmox-installer-monitor")
BACKUPS = pathlib.Path("/home/backups/proxmox-managed-updates")
DASH = pathlib.Path("/opt/dashboard/static")
API = "https://api.github.com/repos/Technox90/homeatic/commits/main"
RAW = "https://raw.githubusercontent.com/Technox90/homeatic/"
KEYS = ("installer", "dashboard", "kuma")

def report(kind, message):
    print(kind + "|" + message, flush=True)

def request(url):
    req = urllib.request.Request(url, headers={"User-Agent":"Proxmox-Proxmox-Updater"})
    with urllib.request.urlopen(req, timeout=30) as response:
        data = response.read(4*1024*1024+1)
    if len(data)>4*1024*1024:
        raise ValueError("Download zu groß")
    return data

def version(data):
    m = re.search(rb"(?m)^# PROXMOX MODULARER KOMPLETT-INSTALLER V([0-9]+)$", data)
    if not m or not data.startswith(b"#!/usr/bin/env bash\n"):
        raise ValueError("Ungültiger Installer")
    return int(m.group(1))

def run(args, **kw):
    return subprocess.run(args, check=True, timeout=60, **kw)

def safe_file(path):
    st=path.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid!=0 or st.st_mode & 0o022:
        raise ValueError("Datei nicht regulär/root-geschützt: "+str(path))
    if path.resolve()!=path:
        raise ValueError("Symlink-Pfad: "+str(path))
    return st

def replace_files(pairs, label):
    changed=[]
    for path, data in pairs:
        st=safe_file(path)
        if path.read_bytes()!=data:
            changed.append((path,data,st))
    if not changed:
        return False
    BACKUPS.mkdir(mode=0o700,parents=True,exist_ok=True)
    backup=pathlib.Path(tempfile.mkdtemp(prefix=label+"-",dir=BACKUPS))
    for i,(path,_,_) in enumerate(changed):
        shutil.copy2(path,backup/str(i))
    (backup/"paths.json").write_text(json.dumps([str(x[0]) for x in changed]))
    done=[]
    def write(path,data,st):
        fd,tmp=tempfile.mkstemp(prefix=".proxmox-update-",dir=path.parent)
        try:
            with os.fdopen(fd,"wb") as f:
                f.write(data)
                f.flush()
                os.fsync(f.fileno())
            os.chown(tmp,st.st_uid,st.st_gid)
            os.chmod(tmp,stat.S_IMODE(st.st_mode))
            os.replace(tmp,path)
        finally:
            if os.path.exists(tmp): os.unlink(tmp)
    try:
        for i,(path,data,st) in enumerate(changed):
            write(path,data,st)
            done.append((i,path,st))
    except Exception:
        for i,path,st in reversed(done):
            write(path,(backup/str(i)).read_bytes(),st)
        raise
    report("INFO","Backup: "+str(backup))
    return True

def extract(text, begin, end):
    if text.count(begin)!=1: raise ValueError("Quellmarker nicht eindeutig")
    tail=text.split(begin,1)[1]
    if end not in tail: raise ValueError("Quellmarker fehlt")
    return tail.split(end,1)[0]

def dashboard_payload(index, css, js):
    pattern=r"/\* PVE_DASHBOARD_BRANDING_V154_BEGIN \*/.*?/\* PVE_DASHBOARD_BRANDING_V154_END \*/"
    matches=list(re.finditer(pattern,index,re.S))
    if len(matches)!=2: raise ValueError("Dashboard-Branding nicht eindeutig; manuelles Update nötig")
    if not all(x in css for x in ("Dashboard Toolbar","dashboardFixedToolbar")) or "brandMenuToggle" not in js:
        raise ValueError("Branding-Quellprüfung fehlgeschlagen")
    if "</style" in css.lower() or "</script" in js.lower(): raise ValueError("Ungültiger HTML-Inhalt")
    # Remove only managed branding blocks; then place them in their own proper contexts.
    clean=re.sub(pattern+r"\n?","",index,flags=re.S)
    clean=re.sub(r'<script\b[^>]*\bid="proxmox-branding(?:-v154)?"[^>]*>\s*</script\s*>\n?',"",clean,flags=re.I)
    monitor=r'<script\s+defer\s+src="/installer-update-v155\.js"\s*>\s*</script\s*>\n?'
    had_monitor=bool(re.search(monitor,clean,re.I))
    clean=re.sub(monitor,"",clean,flags=re.I)
    def block(value):
        return "/* PVE_DASHBOARD_BRANDING_V154_BEGIN */\n"+value+"\n/* PVE_DASHBOARD_BRANDING_V154_END */"
    if "</style>" not in clean or len(re.findall(r"</body\s*>",clean,re.I))!=1:
        raise ValueError("Dashboard-Struktur nicht eindeutig")
    clean=clean.replace("</style>",block(css)+"\n</style>",1)
    tag='<script id="proxmox-branding">\n'+block(js)+'\n</script>\n'
    if had_monitor:
        tag+='<script defer src="/installer-update-v155.js"></script>\n'
    return re.sub(r"</body\s*>",lambda m:tag+m.group(),clean,count=1,flags=re.I)


def install_dashboard_ping(download):
    if not (DASH/"index.html").is_file():
        return
    if not shutil.which("ping"):
        run(["apt-get","install","-y","iputils-ping"],capture_output=True)
    script=download("proxmox/tools/proxmox-dashboard-ping")
    unit=download("proxmox/tools/proxmox-dashboard-ping.service")
    compile(script,"proxmox-dashboard-ping","exec")
    if b"ExecStart=/usr/bin/python3 /usr/local/sbin/proxmox-dashboard-ping" not in unit:
        raise ValueError("Ungültiger Ping-Dienst")
    changed=False
    for path,data,mode in ((pathlib.Path("/usr/local/sbin/proxmox-dashboard-ping"),script,0o755),(pathlib.Path("/etc/systemd/system/proxmox-dashboard-ping.service"),unit,0o644)):
        if path.exists() or path.is_symlink():
            safe_file(path)
            changed=replace_files([(path,data)],"dashboard-ping") or changed
        else:
            fd,tmp=tempfile.mkstemp(prefix=".dashboard-ping-",dir=path.parent)
            try:
                with os.fdopen(fd,"wb") as fp: fp.write(data)
                os.chmod(tmp,mode)
                os.replace(tmp,path)
            finally:
                if os.path.exists(tmp): os.unlink(tmp)
            changed=True
    if changed: run(["systemctl","daemon-reload"])
    run(["systemctl","enable","--now","proxmox-dashboard-ping.service"],capture_output=True)
    if changed: run(["systemctl","restart","proxmox-dashboard-ping.service"])
    report("UPDATED" if changed else "INFO","Dashboard-Ping: Dienst aktiviert")

def dashboard_update(master,download):
    index=DASH/"index.html"
    overlay=DASH/"installer-update-v155.js"
    if not index.is_file():
        report("INFO","Dashboard nicht installiert; übersprungen")
        return
    if not overlay.is_file():
        report("MANUAL","Dashboard: V155-Updateanzeige fehlt; einmal manuell aktualisieren")
        return
    safe_file(index)
    safe_file(overlay)
    text=index.read_text()
    if '<script defer src="/installer-update-v155.js">' not in text:
        report("MANUAL","Dashboard: Updateanzeige nicht eingebunden")
        return
    css=download("dashboard/branding-v154.css").decode()
    js=download("dashboard/branding-v154.js").decode()
    new_index=dashboard_payload(text,css,js)
    new_overlay=extract(master,'js="""(() => {\n','})();"""')
    new_overlay="(() => {\n"+new_overlay+"})();"
    if "proxmox-installer-update" not in new_overlay:
        raise ValueError("Updateanzeige ungültig")
    pairs=[(index,new_index.encode()),(overlay,new_overlay.encode())]
    runtime=download("dashboard/views/runtime.js")
    if b"view-view-badge" not in runtime or b'createElement("span")' not in runtime or b"badge.remove()" not in runtime:
        raise ValueError("Theme-Runtime ungültig")
    for target in (DASH/"proxmox-views/runtime.js",pathlib.Path("/home/downloads/proxmox/dashboard-views/v1/runtime.js"),pathlib.Path("/home/downloads/proxmox/dashboard-views/v2/runtime.js"),pathlib.Path("/home/downloads/proxmox/dashboard-views/v3/runtime.js")):
        if target.is_file(): pairs.append((target,runtime))
    install_dashboard_ping(download)
    if replace_files(pairs,"dashboard"):
        report("UPDATED","Dashboard: verwaltete Toolbar und Installer-Updateanzeige")
    else:
        report("INFO","Dashboard-Oberfläche aktuell")

def kuma_update(master):
    listing=run(["pct","list"],capture_output=True,text=True).stdout
    ids=[]
    for line in listing.splitlines()[1:]:
        parts=line.split()
        if not parts or not parts[0].isdigit(): continue
        config=run(["pct","config",parts[0]],capture_output=True,text=True).stdout
        if re.search(r"(?m)^hostname: uptime-kuma$",config,re.I): ids.append(parts[0])
    if not ids:
        report("INFO","Uptime Kuma nicht installiert; übersprungen")
        return
    if len(ids)!=1:
        report("MANUAL","Mehrere Kuma-LXC; keine Änderung")
        return
    ct=ids[0]
    if "status: running" not in run(["pct","status",ct],capture_output=True,text=True).stdout:
        report("INFO","Kuma gestoppt; übersprungen")
        return
    # UPPER is opt-in; recognize old installs only for migration.
    probe=r"""set -eu
conf=/etc/nginx/conf.d/pve-master-standard-web.conf
if [ -f /var/www/upper/index.html ] || [ -f /var/www/nodezero-kuma-status/index.html ] || grep -Eq 'UPPER PUBLIC STATUS|NODEZERO KUMA PUBLIC STATUS V155' "$conf" 2>/dev/null; then echo installed; else echo missing; fi
"""
    result=run(["pct","exec",ct,"--","bash","-c",probe],capture_output=True,text=True).stdout.strip()
    if result=="missing":
        report("INFO","UPPER nicht installiert; übersprungen")
        return
    if result!="installed": raise ValueError("Unerwartete UPPER-Rückmeldung")
    shell=extract(master,"<<'KUMA_STATUS_INSTALL'\n","\nKUMA_STATUS_INSTALL\n")+"\n"
    if "/var/www/upper" not in shell or "UPPER PUBLIC STATUS" not in shell:
        raise ValueError("Ungültiger UPPER-Installer")
    result=subprocess.run(["pct","exec",ct,"--","bash","-s"],input=shell,text=True,capture_output=True,timeout=120)
    if result.returncode:
        raise ValueError("UPPER-Installation fehlgeschlagen: "+(result.stderr or result.stdout)[-500:])
    report("INFO" if "UPPER_CURRENT" in result.stdout else "UPDATED","UPPER: öffentliche Statusseite geprüft")


def installer_update(remote, download):
    path=pathlib.Path((STATE/"installer-path").read_text().strip())
    if path not in (pathlib.Path("/root/proxmox.sh"),pathlib.Path("/usr/local/sbin/proxmox.sh")):
        raise ValueError("Nicht unterstützter Installer-Pfad; manuelles Update nötig")
    safe_file(path)
    old=version(path.read_bytes())
    new=version(remote)
    if new<old:
        report("MANUAL","Lokaler Installer neuer; kein Downgrade")
        return
    if new==old:
        report("INFO",f"Installer V{old} aktuell")
        return
    run(["bash","-n"],input=remote,capture_output=True)
    # Install tools from exactly the pinned source used by the new installer.
    m=re.search(rb'(?m)^TOOLS_REF="([0-9a-f]{40})"$',remote)
    if not m: raise ValueError("Tools-Referenz fehlt")
    ref=m.group(1).decode()
    pairs=[]
    for name in ("proxmox-auto-updater","proxmox-auto-updater-config","proxmox-managed-updates"):
        target=pathlib.Path("/usr/local/sbin")/name
        if not target.is_file(): raise ValueError("Updater-Tool fehlt: "+name)
        data=request(RAW+ref+"/proxmox/tools/"+name)
        if name=="proxmox-managed-updates":
            compile(data,name,"exec")
        else:
            if not data.startswith(b"#!/usr/bin/env bash\n"): raise ValueError("Ungültiges Tool")
            run(["bash","-n"],input=data,capture_output=True)
        pairs.append((target,data))
    pairs.append((path,remote))
    if replace_files(pairs,"installer"):
        report("UPDATED",f"Master-Installer V{old} → V{new} inkl. Updater-Werkzeuge")

def main():
    if not CONF.exists(): return 0
    safe_file(CONF)
    cfg=json.loads(CONF.read_text())
    if not isinstance(cfg,dict) or any(type(cfg.get(k,False)) is not bool for k in KEYS):
        raise ValueError("Ungültige Update-Konfiguration")
    if not any(cfg.get(k,False) for k in KEYS): return 0
    sha=json.loads(request(API))["sha"]
    if not re.fullmatch(r"[0-9a-f]{40}",sha): raise ValueError("Ungültiger GitHub-Commit")
    def download(path): return request(RAW+sha+"/"+path)
    remote=download("proxmox/proxmox.sh")
    version(remote)
    run(["bash","-n"],input=remote,capture_output=True)
    master=remote.decode()
    failed=False
    for key,fn in (("installer",lambda:installer_update(remote,download)),("dashboard",lambda:dashboard_update(master,download)),("kuma",lambda:kuma_update(master))):
        if not cfg.get(key,False): continue
        try: fn()
        except Exception as exc:
            report("FAILED",key+": "+type(exc).__name__+" – "+str(exc).splitlines()[0][:200])
            failed=True
    return int(failed)

if __name__=="__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        report("FAILED","Proxmox-Updateprüfung: "+type(exc).__name__)
        raise SystemExit(1)
