After=pve-cluster.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/proxmox-managed-updates --timezone-only
TimeoutStartSec=10min
""",
        "proxmox-timezone-sync.timer":"""[Unit]
Description=Proxmox Zeitzonenabgleich alle 15 Minuten
[Timer]
OnBootSec=2min
OnUnitInactiveSec=15min
Unit=proxmox-timezone-sync.service
[Install]
WantedBy=timers.target
"""
    }
    changed=False
    for name,value in units.items():
        path=pathlib.Path("/etc/systemd/system")/name
        data=value.encode()
        if path.exists() or path.is_symlink():
            changed=replace_files([(path,data)],"timezone-sync") or changed
        else:
            fd,tmp=tempfile.mkstemp(prefix=".timezone-sync-",dir=path.parent)
            try:
                with os.fdopen(fd,"wb") as fp:fp.write(data)
                os.chmod(tmp,0o644)
                os.replace(tmp,path)
            finally:
                if os.path.exists(tmp):os.unlink(tmp)
            changed=True
    if changed:run(["systemctl","daemon-reload"])
    run(["systemctl","enable","--now","proxmox-timezone-sync.timer"],capture_output=True)

def installer_update(remote, download):
    path=pathlib.Path((STATE/"installer-path").read_text().strip())
    if path not in (pathlib.Path("/root/proxmox.sh"),pathlib.Path("/usr/local/sbin/proxmox.sh")):
        raise ValueError("Nicht unterstützter Installer-Pfad; manuelles Update nötig")
    safe_file(path)
    old=version(path.read_bytes())
    new=version(remote)
    if new<old:
        report("MANUAL","Lokaler Installer neuer; kein Downgrade")
        return
    if new==old:
        report("INFO",f"Installer V{old} aktuell")
        return
    run(["bash","-n"],input=remote,capture_output=True)
    # Install tools from exactly the pinned source used by the new installer.
    m=re.search(rb'(?m)^TOOLS_REF="([0-9a-f]{40})"$',remote)
    if not m: raise ValueError("Tools-Referenz fehlt")
    ref=m.group(1).decode()
    pairs=[]
    for name in ("proxmox-auto-updater","proxmox-auto-updater-config","proxmox-managed-updates","proxmox-external-urls"):
        target=pathlib.Path("/usr/local/sbin")/name
        if not target.is_file(): raise ValueError("Updater-Tool fehlt: "+name)
        data=request(RAW+ref+"/proxmox/tools/"+name)
        if name in ("proxmox-managed-updates","proxmox-external-urls"):
            compile(data,name,"exec")
        else:
            if not data.startswith(b"#!/usr/bin/env bash\n"): raise ValueError("Ungültiges Tool")
            run(["bash","-n"],input=data,capture_output=True)
        pairs.append((target,data))
    pairs.append((path,remote))
    if replace_files(pairs,"installer"):
        report("UPDATED",f"Master-Installer V{old} → V{new} inkl. Updater-Werkzeuge")

def install_monitor_timer(master):
    target=pathlib.Path("/etc/systemd/system/proxmox-installer-monitor.timer")
    if not target.is_file():
        report("MANUAL","Installer-Monitor fehlt; Installer einmal ausführen")
        return
    timer=extract(master,"<<'MONITOR_TIMER'\n","\nMONITOR_TIMER")
    if "OnCalendar=*:00/5" not in timer:
        raise ValueError("Ungültiger Installer-Monitor-Timer")
    if replace_files([(target,(timer+"\n").encode())],"monitor-timer"):
        run(["systemctl","daemon-reload"])
        run(["systemctl","restart","proxmox-installer-monitor.timer"],capture_output=True)
        report("UPDATED","Installer-Monitor: feste 5-Minuten-Intervalle")

def main():
    if not CONF.exists(): return 0
    safe_file(CONF)
    cfg=json.loads(CONF.read_text())
    if not isinstance(cfg,dict) or any(type(cfg.get(k,False)) is not bool for k in KEYS):
        raise ValueError("Ungültige Update-Konfiguration")
    if not any(cfg.get(k,False) for k in KEYS): return 0
    release=json.loads(request(API))
    tag=release.get("tag_name","")
    if release.get("draft") or release.get("prerelease") or not re.fullmatch(r"V[0-9]+",tag):
        raise ValueError("Kein stabiler Proxmox-Release")
    sha=json.loads(request("https://api.github.com/repos/Technox90/homeatic/commits/"+tag))["sha"]
    if not re.fullmatch(r"[0-9a-f]{40}",sha): raise ValueError("Ungültiger GitHub-Commit")
    def download(path): return request(RAW+sha+"/"+path)
    remote=download("proxmox/proxmox.sh")
    if "V"+str(version(remote)) != tag: raise ValueError("Release und Installer-Version stimmen nicht überein")
    run(["bash","-n"],input=remote,capture_output=True)
    master=remote.decode()
    failed=False
    for key,fn in (("installer",lambda:installer_update(remote,download)),("dashboard",lambda:dashboard_update(master,download)),("kuma",lambda:kuma_update(master))):
        if not cfg.get(key,False): continue
        try: fn()
        except Exception as exc:
            report("FAILED",key+": "+type(exc).__name__+" – "+str(exc).splitlines()[0][:200])
            failed=True
    if cfg.get("installer",False):
        try:
            install_monitor_timer(master)
            install_timezone_timer()
            # systemd serializes timer and explicit runs of the same unit.
            run(["systemctl","start","--no-block","proxmox-timezone-sync.service"],capture_output=True)
        except Exception as exc:
            report("MANUAL","Zeitzonenprüfung: "+type(exc).__name__)
    return int(failed)

if __name__=="__main__":
    try:
        if sys.argv[1:]==["--timezone-init"]:
            install_timezone_timer()
            run(["systemctl","start","proxmox-timezone-sync.service"],capture_output=True)
            raise SystemExit(0)
        if sys.argv[1:]==["--timezone-only"]:
            timezone_update()
            raise SystemExit(0)
        if len(sys.argv)==4 and sys.argv[1]=="--timezone-docker" and sys.argv[2].isdigit():
            timezone_docker(sys.argv[2],sys.argv[3])
            raise SystemExit(0)
        if sys.argv[1:]:
            raise SystemExit("Unbekannte Option")
        raise SystemExit(main())
    except Exception as exc:
        report("FAILED","Proxmox-Updateprüfung: "+type(exc).__name__)
        raise SystemExit(1)
