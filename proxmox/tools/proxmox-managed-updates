def timezone_docker(ct,hostname):
    spec=DOCKER_TIMEZONES.get(hostname)
    if spec is None:
        return
    directory,service,keys=spec
    zone,_=host_timezone()
    result=subprocess.run(["pct","exec",ct,"--","python3","-",directory,service,zone,*keys],input=DOCKER_ZONE_SCRIPT,text=True,capture_output=True,timeout=180)
    if result.returncode:
        # Never log compose config, tokens, or arbitrary child output.
        raise RuntimeError("Docker-Zeitzonenabgleich fehlgeschlagen; Compose-Projekt prüfen")
    state=result.stdout.strip()
    if state not in ("CURRENT","UPDATED"):raise ValueError("Unbekannter Zeitzonenstatus")
    report(state if state=="UPDATED" else "INFO",hostname+" Docker-Zeitzone: "+zone)

def install_timezone_timer():
    units={
        "proxmox-timezone-sync.service":"""[Unit]
