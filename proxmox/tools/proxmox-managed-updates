def report(kind, message):
    print(kind + "|" + message, flush=True)

def request(url):
    req = urllib.request.Request(url, headers={"User-Agent":"Proxmox-Proxmox-Updater"})
    with urllib.request.urlopen(req, timeout=30) as response:
        data = response.read(4*1024*1024+1)
    if len(data)>4*1024*1024:
        raise ValueError("Download zu groß")
    return data

def version(data):
    m = re.search(rb"(?m)^# PROXMOX MODULARER KOMPLETT-INSTALLER V([0-9]+)$", data)
    if not m or not data.startswith(b"#!/usr/bin/env bash\n"):
        raise ValueError("Ungültiger Installer")
    return int(m.group(1))

def run(args, **kw):
    return subprocess.run(args, check=True, timeout=60, **kw)

def safe_file(path):
    st=path.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid!=0 or st.st_mode & 0o022:
        raise ValueError("Datei nicht regulär/root-geschützt: "+str(path))
    if path.resolve()!=path:
        raise ValueError("Symlink-Pfad: "+str(path))
    return st

def replace_files(pairs, label):
    changed=[]
    for path, data in pairs:
        st=safe_file(path)
        if path.read_bytes()!=data:
            changed.append((path,data,st))
    if not changed:
        return False
    BACKUPS.mkdir(mode=0o700,parents=True,exist_ok=True)
    backup=pathlib.Path(tempfile.mkdtemp(prefix=label+"-",dir=BACKUPS))
    for i,(path,_,_) in enumerate(changed):
        shutil.copy2(path,backup/str(i))
    (backup/"paths.json").write_text(json.dumps([str(x[0]) for x in changed]))
    done=[]
    def write(path,data,st):
        fd,tmp=tempfile.mkstemp(prefix=".proxmox-update-",dir=path.parent)
        try:
            with os.fdopen(fd,"wb") as f:
                f.write(data)
                f.flush()
                os.fsync(f.fileno())
            os.chown(tmp,st.st_uid,st.st_gid)
            os.chmod(tmp,stat.S_IMODE(st.st_mode))
            os.replace(tmp,path)
        finally:
            if os.path.exists(tmp): os.unlink(tmp)
    try:
        for i,(path,data,st) in enumerate(changed):
            write(path,data,st)
            done.append((i,path,st))
    except Exception:
        for i,path,st in reversed(done):
            write(path,(backup/str(i)).read_bytes(),st)
        raise
    report("INFO","Backup: "+str(backup))
    return True

def extract(text, begin, end):
    if text.count(begin)!=1: raise ValueError("Quellmarker nicht eindeutig")
    tail=text.split(begin,1)[1]
    if end not in tail: raise ValueError("Quellmarker fehlt")
    return tail.split(end,1)[0]

def dashboard_payload(index, css, js):
    pattern=r"/\* PVE_DASHBOARD_BRANDING_V154_BEGIN \*/.*?/\* PVE_DASHBOARD_BRANDING_V154_END \*/"
    matches=list(re.finditer(pattern,index,re.S))
    if len(matches)!=2: raise ValueError("Dashboard-Branding nicht eindeutig; manuelles Update nötig")
    if not all(x in css for x in ("Dashboard Toolbar","dashboardFixedToolbar")) or "brandMenuToggle" not in js:
        raise ValueError("Branding-Quellprüfung fehlgeschlagen")
    if "</style" in css.lower() or "</script" in js.lower(): raise ValueError("Ungültiger HTML-Inhalt")
    # Remove only managed branding blocks; then place them in their own proper contexts.
    clean=re.sub(pattern+r"\n?","",index,flags=re.S)
    clean=re.sub(r'<script\b[^>]*\bid="proxmox-branding(?:-v154)?"[^>]*>\s*</script\s*>\n?',"",clean,flags=re.I)
    monitor=r'<script\s+defer\s+src="/installer-update-v155\.js"\s*>\s*</script\s*>\n?'
    had_monitor=bool(re.search(monitor,clean,re.I))
    clean=re.sub(monitor,"",clean,flags=re.I)
    def block(value):
        return "/* PVE_DASHBOARD_BRANDING_V154_BEGIN */\n"+value+"\n/* PVE_DASHBOARD_BRANDING_V154_END */"
    if "</style>" not in clean or len(re.findall(r"</body\s*>",clean,re.I))!=1:
        raise ValueError("Dashboard-Struktur nicht eindeutig")
    clean=clean.replace("</style>",block(css)+"\n</style>",1)
    tag='<script id="proxmox-branding">\n'+block(js)+'\n</script>\n'
    if had_monitor:
        tag+='<script defer src="/installer-update-v155.js"></script>\n'
    return re.sub(r"</body\s*>",lambda m:tag+m.group(),clean,count=1,flags=re.I)


def install_dashboard_ping(download):
    if not (DASH/"index.html").is_file():
        return
    if not shutil.which("ping"):
        run(["apt-get","install","-y","iputils-ping"],capture_output=True)
    script=download("proxmox/tools/proxmox-dashboard-ping")
    unit=download("proxmox/tools/proxmox-dashboard-ping.service")
    compile(script,"proxmox-dashboard-ping","exec")
    if b"ExecStart=/usr/bin/python3 /usr/local/sbin/proxmox-dashboard-ping" not in unit:
        raise ValueError("Ungültiger Ping-Dienst")
    changed=False
    for path,data,mode in ((pathlib.Path("/usr/local/sbin/proxmox-dashboard-ping"),script,0o755),(pathlib.Path("/etc/systemd/system/proxmox-dashboard-ping.service"),unit,0o644)):
        if path.exists() or path.is_symlink():
            safe_file(path)
            changed=replace_files([(path,data)],"dashboard-ping") or changed
        else:
            fd,tmp=tempfile.mkstemp(prefix=".dashboard-ping-",dir=path.parent)
            try:
                with os.fdopen(fd,"wb") as fp: fp.write(data)
                os.chmod(tmp,mode)
                os.replace(tmp,path)
            finally:
                if os.path.exists(tmp): os.unlink(tmp)
            changed=True
    if changed: run(["systemctl","daemon-reload"])
    run(["systemctl","enable","--now","proxmox-dashboard-ping.service"],capture_output=True)
    if changed: run(["systemctl","restart","proxmox-dashboard-ping.service"])
    report("UPDATED" if changed else "INFO","Dashboard-Ping: Dienst aktiviert")

