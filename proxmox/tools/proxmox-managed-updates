details=json.loads(docker("inspect",ids[0]))[0]
labels=details["Config"].get("Labels") or {}
if labels.get("com.docker.compose.service")!=service or labels.get("com.docker.compose.project.working_dir")!=directory or labels.get("com.docker.compose.project.config_files")!=str(path):
