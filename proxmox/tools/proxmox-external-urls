"""
                run(["pct", "exec", ctid, "--", "env", f"NZ_URL={url}", "python3", "-c", code])
                run(["pct", "exec", ctid, "--", "bash", "-lc", "systemctl restart pocket-id 2>/dev/null || systemctl restart pocketid 2>/dev/null || true"], capture=False)
        elif s["key"] == "pulse":
            ctid = find_ctid("pulse")
            if ctid:
                command = (
                    "f=/opt/pulse/.env; [ -f $f ] || exit 0; "
                    "sed -i -E '/^PULSE_PUBLIC_URL=/d; /^ALLOWED_ORIGINS=/d' $f; "
                    f"printf 'PULSE_PUBLIC_URL={url}\\nALLOWED_ORIGINS={url}\\n' >> $f; "
                    "systemctl restart pulse 2>/dev/null || true"
                )
                run(["pct", "exec", ctid, "--", "bash", "-lc", command], capture=False)

def apply(cfg):
    write_dns(cfg)
    ensure_packages()
    write_acme(cfg)
    cert_dir = ensure_certificate(cfg)
    write_proxy(cfg, cert_dir)
    apply_app_urls(cfg)

def refresh_backends(cfg):
    saved = {s["key"]: s for s in cfg.get("services", [])}
    cfg["services"] = build_catalog(saved)

def show_status(cfg):
    print("=" * 68)
    print(" PROXMOX EXTERNE URLS")
    print("=" * 68)
    print(summary(cfg))
    print()
    print(f"Konfiguration: {CONFIG_FILE}")
    print(f"DNS-Vorgaben: {DNS_FILE}")
    print(f"Log: {LOGFILE}")
    print()
    run(["nginx", "-t"], capture=False)
    if shutil.which("certbot"):
        run(["certbot", "certificates"], capture=False)

def interactive(cfg):
    cfg["base_domain"] = normalize_domain(ask("EXTERNE URLS", "Hauptdomain der Dienste, z. B. example.de", cfg.get("base_domain", "")))
    if not valid_host(cfg["base_domain"]):
        raise SystemExit("FEHLER: Ungültige Hauptdomain.")
    cfg["dns_target"] = normalize_domain(ask(
        "REVERSE PROXY / DNS / DYNDNS",
        "Zentrale öffentliche Zieladresse des Reverse-Proxys (CNAME/DynDNS).\nAlle Dienst-Subdomains verweisen darauf, z. B. home.example.de.\nLeer = direkte A-/AAAA-Einträge.",
        cfg.get("dns_target", ""),
    ))
    if cfg["dns_target"] and not valid_host(cfg["dns_target"]):
        raise SystemExit("FEHLER: Ungültiges CNAME-/DynDNS-Ziel.")
    cfg["email"] = ask("LET'S ENCRYPT", "E-Mail für Let's Encrypt (optional)", cfg.get("email", ""))
    refresh_backends(cfg)
    if not configure_selection(cfg["services"], cfg["base_domain"]):
        return False
    return edit_loop(cfg)

def main():
    cfg = load_config()
    mode = sys.argv[1] if len(sys.argv) > 1 else ""

    if mode == "--status":
        refresh_backends(cfg)
        show_status(cfg)
        return

    if mode == "--reapply":
        if not cfg.get("base_domain"):
            return
        refresh_backends(cfg)
        save_config(cfg)
        apply(cfg)
        return

    try:
        if not interactive(cfg):
            print("Abgebrochen.")
            return
    except KeyboardInterrupt:
        print("\nAbgebrochen.")
        return

    save_config(cfg)
    print(f"\nDNS-Vorgaben: {DNS_FILE}")
    print("WICHTIG: TCP 80 und 443 müssen aus dem Internet auf diesen Proxmox-Host zeigen.")
    apply(cfg)

    print("\n" + "=" * 68)
    print(" EXTERNE URLS AKTIV")
    print("=" * 68)
    print(summary(cfg))
    print(f"\nKonfiguration: {CONFIG_FILE}")
    print(f"DNS-Vorgaben: {DNS_FILE}")
    print(f"Log: {LOGFILE}")
    print("\nHome Assistant: Falls HA '400 Bad Request' meldet, den Proxmox-Host")
    print("unter http: trusted_proxies in Home Assistant freigeben.")

if __name__ == "__main__":
    main()
