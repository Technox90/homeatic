def interactive(cfg):
    if valid_host(cfg.get("base_domain", "")):
        refresh_backends(cfg)
        return edit_loop(cfg)
    cfg["base_domain"] = normalize_domain(ask("EXTERNE URLS", "Hauptdomain der Dienste, z. B. example.de", cfg.get("base_domain", "")))
    if not valid_host(cfg["base_domain"]):
        raise SystemExit("FEHLER: Ungültige Hauptdomain.")
    cfg["dns_target"] = normalize_domain(ask(
        "REVERSE PROXY / DNS / DYNDNS",
        "Zentrale öffentliche Zieladresse des Reverse-Proxys (CNAME/DynDNS).\nAlle Dienst-Subdomains verweisen darauf, z. B. home.example.de.\nLeer = direkte A-/AAAA-Einträge.",
        cfg.get("dns_target", ""), allow_empty=True,
    ))
    if cfg["dns_target"] and not valid_host(cfg["dns_target"]):
        raise SystemExit("FEHLER: Ungültiges CNAME-/DynDNS-Ziel.")
    cfg["email"] = ask("LET'S ENCRYPT", "E-Mail für Let's Encrypt (optional)", cfg.get("email", ""))
    refresh_backends(cfg)
    if not configure_selection(cfg["services"], cfg["base_domain"]):
        return False
    return edit_loop(cfg)

def main():
    cfg = load_config()
    mode = sys.argv[1] if len(sys.argv) > 1 else ""

    if mode == "--status":
        refresh_backends(cfg)
        show_status(cfg)
        return

    if mode == "--reapply":
        if not cfg.get("base_domain"):
            return
        refresh_backends(cfg)
        apply(cfg)
        save_config(cfg)
        return

    try:
        if not interactive(cfg):
            print("Abgebrochen.")
            return
    except KeyboardInterrupt:
        print("\nAbgebrochen.")
        return

    print(f"\nDNS-Vorgaben: {DNS_FILE}")
    print("WICHTIG: TCP 80 und 443 müssen aus dem Internet auf diesen Proxmox-Host zeigen.")
    apply(cfg)
    save_config(cfg)

    print("\n" + "=" * 68)
    print(" EXTERNE URLS AKTIV")
    print("=" * 68)
    print(summary(cfg))
    print(f"\nKonfiguration: {CONFIG_FILE}")
    print(f"DNS-Vorgaben: {DNS_FILE}")
    print(f"Log: {LOGFILE}")
    print("\nHome Assistant: Falls HA '400 Bad Request' meldet, den Proxmox-Host")
    print("unter http: trusted_proxies in Home Assistant freigeben.")

if __name__ == "__main__":
    main()
