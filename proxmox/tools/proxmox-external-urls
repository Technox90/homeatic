def apply_app_urls(cfg):
    for s in enabled_services(cfg):
        host = proposed_host(s, cfg["base_domain"])
        url = f"https://{host}"
        mapping = {
            "paper": ("paperless", "/opt/paperless/docker-compose.yml", "PAPERLESS_URL", url, "/opt/paperless"),
            "vault": ("vaultwarden", "/opt/vaultwarden/docker-compose.yml", "DOMAIN", url, "/opt/vaultwarden"),
            "ntfy": ("ntfy", "/opt/ntfy/docker-compose.yml", "NTFY_BASE_URL", url, "/opt/ntfy"),
            "forgejo": ("forgejo", "/opt/forgejo/docker-compose.yml", "FORGEJO__server__ROOT_URL", url + "/", "/opt/forgejo"),
            "speedtest": ("speedtest-tracker", "/opt/speedtest-tracker/docker-compose.yml", "APP_URL", url, "/opt/speedtest-tracker"),
            "mealie": ("mealie", "/opt/mealie/docker-compose.yml", "BASE_URL", url, "/opt/mealie"),
        }
        if s["key"] in mapping:
            hostname, file, key, value, workdir = mapping[s["key"]]
            ctid = find_ctid(hostname)
            if ctid:
                patch_compose_key(ctid, file, key, value, workdir)
        elif s["key"] == "pocketid":
            ctid = find_ctid("pocketid")
            if ctid:
                code = r"""from pathlib import Path
