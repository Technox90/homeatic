class Tee:
    def __init__(self, stream, file):
        self.stream = stream
        self.file = file
    def write(self, data):
        self.stream.write(data)
        self.file.write(data)
        self.file.flush()
    def flush(self):
        self.stream.flush()
        self.file.flush()

